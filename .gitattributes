* text=auto

# 源码与配置统一用 LF，避免 Windows/Mac 两台上互相产生"整个文件都改了"的 diff
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.ts     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sql    text eol=lf

# Windows 批处理必须是 CRLF，否则可能执行失败
*.cmd    text eol=crlf
*.bat    text eol=crlf

# 二进制：不要做任何换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.jar    binary
*.war    binary
*.docx   binary
*.xlsx   binary
*.pdf    binary
